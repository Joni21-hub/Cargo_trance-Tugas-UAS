{
  "info": {
    "name": "Meridian (CargoTrace) REST API v1",
    "_postman_id": "8e3b7e20-6c4d-4d89-9a4a-3b6e82c41101",
    "description": "Postman collection for Meridian (CargoTrace) Global Shipment Visibility & Tracking Platform. Run Login first so Postman stores the Laravel session cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1", "type": "string" },
    { "key": "tracking_number", "value": "MRD-20261122-0001", "type": "string" },
    { "key": "shipment_id", "value": "1", "type": "string" },
    { "key": "exception_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication & Bootstrap",
