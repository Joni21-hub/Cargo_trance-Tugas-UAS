    {
      "name": "2. Shipments & Lifecycle",
      "item": [
        {
          "name": "List Shipments (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/shipments?per_page=15",
              "host": ["{{base_url}}"],
              "path": ["shipments"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "status", "value": "IN_TRANSIT", "disabled": true },
                { "key": "is_delayed", "value": "true", "disabled": true },
                { "key": "search", "value": "CSQU", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Shipment Detail & Weather",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/shipments/{{tracking_number}}",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{tracking_number}}"]
            }
          }
        },
        {
          "name": "Create Shipment (ISO 6346)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking_number\": \"MRD-20261122-0001\",\n  \"container_number\": \"CSQU3054383\",\n  \"customer_id\": 3,\n  \"buyer_id\": 5,\n  \"carrier_id\": 1,\n  \"origin_location_id\": 1,\n  \"destination_location_id\": 3,\n  \"cargo_description\": \"Kopi Arabika Gayo Grade 1 (500 karung)\",\n  \"weight_kg\": 18500,\n  \"volume_cbm\": 64,\n  \"expected_departure\": \"2026-11-23 08:00:00\",\n  \"expected_arrival\": \"2026-12-10 18:00:00\",\n  \"notes\": \"Sertifikat phytosanitary terlampir\",\n  \"items\": [\n    {\n      \"item_name\": \"Kopi Arabika Gayo Grade 1\",\n      \"category\": \"Hasil Bumi & Kopi\",\n      \"quantity\": 500,\n      \"weight_kg\": 18500,\n      \"condition\": \"BAIK & SEGEL UTUH\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/shipments",
              "host": ["{{base_url}}"],
              "path": ["shipments"]
            }
          }
        },
        {
          "name": "Update Shipment (Operator/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Dokumen ekspor terverifikasi oleh operator pelabuhan.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}"]
            }
          }
        },
        {
          "name": "Confirm by Shipper",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}/confirm-shipper",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}", "confirm-shipper"]
            }
          }
        },
        {
          "name": "Confirm Receipt by Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}/confirm-buyer",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}", "confirm-buyer"]
            }
          }
        },
        {
          "name": "Delete Shipment (Operator/Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}"]
            }
          }
        }
      ]
    },
