        },
        {
          "name": "Record Exception & Recalculate ETA (Operator/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exception_type\": \"CUSTOMS_HOLD\",\n  \"severity\": \"HIGH\",\n  \"impact_hours\": 24,\n  \"description\": \"Penahanan kontainer oleh otoritas bea cukai untuk pemeriksaan dokumen ekspor.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}/exceptions",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}", "exceptions"]
            }
          }
        },
        {
          "name": "Resolve Exception (Operator/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution_notes\": \"Dokumen terverifikasi, kontainer melanjutkan pelayaran.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/exceptions/{{exception_id}}/resolve",
              "host": ["{{base_url}}"],
              "path": ["exceptions", "{{exception_id}}", "resolve"]
            }
          }
        }
      ]
    },
